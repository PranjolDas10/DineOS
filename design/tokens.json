{
  "$description": "DineOS design tokens. Edit here, then run `node design/build-tokens.mjs`. Components use the semantic names only.",
  "primitive": {
    "slate": {
      "50": "#f5f6f8", "100": "#eceef2", "200": "#dde1e7", "300": "#c3cad4", "400": "#8b95a4",
      "500": "#64707f", "600": "#4f5b6a", "700": "#3a4451", "800": "#262e38", "900": "#18202a", "950": "#0f141b"
    },
    "saffron": {
      "50": "#fff7eb", "100": "#feeccc", "200": "#fbd593", "300": "#f6bb57", "400": "#f0a63a",
      "500": "#e0900f", "600": "#c77700", "700": "#9a5800", "800": "#6e3f02", "900": "#3a2a12", "ink": "#1f1300"
    },
    "green": { "light": "#1f6b3a", "light-bg": "#e5f4ea", "dark": "#8fdcaa", "dark-bg": "#163222" },
    "amber": { "light": "#8a5300", "light-bg": "#fff4dc", "dark": "#ffcf7a", "dark-bg": "#3a2c12" },
    "red": { "light": "#b42318", "light-bg": "#fdecea", "dark": "#ff9b8f", "dark-bg": "#3d1a17" },
    "blue": { "light": "#1d4ed8", "dark": "#8ab4ff" },
    "white": "#ffffff"
  },
  "semantic": {
    "light": {
      "bg": "slate.50", "surface": "white", "surface-sunken": "slate.100",
      "line": "slate.200", "line-strong": "slate.300",
      "fg": "slate.900", "fg-muted": "slate.600",
      "primary": "saffron.500", "on-primary": "saffron.ink", "primary-text": "saffron.700", "primary-soft": "saffron.50",
      "ok": "green.light", "ok-bg": "green.light-bg",
      "warn": "amber.light", "warn-bg": "amber.light-bg",
      "danger": "red.light", "danger-bg": "red.light-bg",
      "focus": "blue.light",
      "chart-food": "slate.700", "chart-commission": "slate.500", "chart-labor": "slate.400",
      "chart-profit": "saffron.600", "chart-loss": "red.light"
    },
    "dark": {
      "bg": "slate.950", "surface": "slate.900", "surface-sunken": "slate.800",
      "line": "slate.800", "line-strong": "slate.700",
      "fg": "slate.50", "fg-muted": "slate.300",
      "primary": "saffron.400", "on-primary": "saffron.ink", "primary-text": "saffron.300", "primary-soft": "saffron.900",
      "ok": "green.dark", "ok-bg": "green.dark-bg",
      "warn": "amber.dark", "warn-bg": "amber.dark-bg",
      "danger": "red.dark", "danger-bg": "red.dark-bg",
      "focus": "blue.dark",
      "chart-food": "slate.200", "chart-commission": "slate.400", "chart-labor": "slate.500",
      "chart-profit": "saffron.400", "chart-loss": "red.dark"
    }
  },
  "contrast": {
    "$description": "Pairs the generator checks in both themes: [foreground, background, minimum ratio]. 4.5 = text, 3 = charts and focus rings (WCAG 2.2 AA).",
    "pairs": [
      ["fg", "bg", 4.5], ["fg", "surface", 4.5], ["fg", "surface-sunken", 4.5],
      ["fg-muted", "surface", 4.5], ["fg-muted", "bg", 4.5], ["fg-muted", "surface-sunken", 4.5],
      ["primary-text", "surface", 4.5], ["primary-text", "bg", 4.5], ["on-primary", "primary", 4.5],
      ["fg", "primary-soft", 4.5],
      ["ok", "ok-bg", 4.5], ["warn", "warn-bg", 4.5], ["danger", "danger-bg", 4.5], ["danger", "surface", 4.5],
      ["focus", "surface", 3], ["focus", "bg", 3],
      ["chart-food", "surface", 3], ["chart-commission", "surface", 3], ["chart-labor", "surface", 3],
      ["chart-profit", "surface", 3], ["chart-loss", "surface", 3]
    ]
  },
  "radius": { "sm": "6px", "md": "10px", "lg": "14px" }
}
