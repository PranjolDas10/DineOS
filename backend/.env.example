# Copy to backend/.env for running the API or tests outside Docker.
# API role: not a superuser, so Postgres RLS applies.
DATABASE_URL=postgresql+asyncpg://dineos_app:dineos_app@localhost:5432/dineos
# Owner role: Alembic and test setup only. Bypasses RLS; the API never reads it.
MIGRATION_DATABASE_URL=postgresql+asyncpg://dineos:dineos@localhost:5432/dineos
# Access-token signing key, at least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
